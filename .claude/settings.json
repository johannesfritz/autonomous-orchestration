      "Bash(playwright:*)",

      "// === PACKAGE MANAGERS & SYSTEM TOOLS ===",
      "Bash(brew:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(cmake:*)",
      "Bash(gcc:*)",
      "Bash(g++:*)",
      "Bash(clang:*)",

      "// === GIT (ALL OPERATIONS) ===",
      "Bash(git:*)",
      "Bash(gh:*)",

      "// === SSH & REMOTE OPERATIONS ===",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",

      "// === DOCKER & CONTAINERS ===",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(podman:*)",

      "// === FILE EXPLORATION (ANYWHERE - READ ONLY) ===",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ag:*)",
      "Bash(fd:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(type:*)",
      "Bash(pwd)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(whoami)",
      "Bash(id)",
      "Bash(uname:*)",

      "// === DESTRUCTIVE BASH OPS (use with caution) ===",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",

      "// === CLAUDE CODE TOOLS (all paths) ===",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Task",

      "// === MCP TOOLS ===",
      "mcp__filesystem__read_file",
      "mcp__filesystem__read_multiple_files",
      "mcp__filesystem__write_file",
      "mcp__filesystem__edit_file",
      "mcp__filesystem__list_directory",
      "mcp__filesystem__directory_tree",
      "mcp__filesystem__search_files",
      "mcp__filesystem__get_file_info",
      "mcp__filesystem__list_allowed_directories",

      "// === STELLARIS ADMIN MCP ===",
      "mcp__stellaris-admin__get_open_feedback",
      "mcp__stellaris-admin__get_feedback_details",
      "mcp__stellaris-admin__update_feedback_status",
      "mcp__stellaris-admin__respond_to_feedback",
      "mcp__stellaris-admin__get_feedback_stats",

      "// === MISC DEV UTILITIES ===",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(man:*)",
      "Bash(tldr:*)",
      "Bash(history:*)",
      "Bash(clear)",
      "Bash(reset)",
      "Bash(true)",
      "Bash(false)",
      "Bash(test:*)",
      "Bash([:*)",
      "Bash(sleep:*)",
      "Bash(time:*)",
      "Bash(timeout:*)",
      "Bash(watch:*)",
      "Bash(nohup:*)",
      "Bash(bg)",
      "Bash(fg)",
      "Bash(jobs)",
      "Bash(ps:*)",
      "Bash(top:*)",
      "Bash(htop:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(pgrep:*)",
      "Bash(lsof:*)",
      "Bash(netstat:*)",
      "Bash(ss:*)",

      "// === NETWORK TESTING (for UAT) ===",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(telnet:*)",
      "Bash(ping:*)",
      "Bash(traceroute:*)",
      "Bash(dig:*)",
      "Bash(nslookup:*)",
      "Bash(host:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf .claude)",
      "Bash(rm -rf .git)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git push -f origin main)",
      "Bash(git push -f origin master)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/quality-check.md && echo '' && cat $CLAUDE_PROJECT_DIR/.claude/protocols/code-standards.md"
          }
        ]
      },
      {
        "matcher": "Bash(git add *)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/scripts/scan-secrets.py"
          }
        ]
      },
      {
        "matcher": "Bash(git commit *)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/scripts/scan-secrets.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/detect-major-changes.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git push *)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-build-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash(rm -rf *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ DESTRUCTIVE: Recursive deletion requested. Verify target path is correct.'"
          }
        ]
      },
      {
        "matcher": "Bash(chmod *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ PERMISSION CHANGE: Verify file permissions are intentional.'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '--- Reminder: Run tests to verify this change works as expected ---'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/detect-production-review.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/detect-fix-request.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "portfolio-manager",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/risk-assessment-required.md"
          }
        ]
      },
      {
        "matcher": "tpm-orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ CRITICAL: Verify risk assessment exists in plan file before execution. Risk Manager invocation is MANDATORY. See .claude/protocols/risk-assessment-required.md for details.'"
          }
        ]
      },
      {
        "matcher": "risk-manager",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🛡️ Risk Manager activated - assessing plan risk dimensions...'"
          }
        ]
      },
      {
        "matcher": "shadow-code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/functional-verification.md && $CLAUDE_PROJECT_DIR/.claude/scripts/detect-major-changes.sh && if [ $? -eq 0 ]; then echo ''; echo '📋 STRICT MODE: Major change detected - applying strict code standards'; cat $CLAUDE_PROJECT_DIR/.claude/protocols/strict-code-standards.md; fi"
          }
        ]
      },
      {
        "matcher": "gardener",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🌿 GARDENER ACTIVATED: Mission is to REDUCE code, not add. Delete duplicates, simplify, consolidate.'"
          }
        ]
      },
      {
        "matcher": "product-manager",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/user-centricity.md"
          }
        ]
      },
      {
        "matcher": "technical-pm",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/technical-translation.md"
          }
        ]
      },
      {
        "matcher": "solutions-architect",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/architectural-documentation.md"
          }
        ]
      },
      {
        "matcher": "ux-researcher",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🔍 UX RESEARCHER ACTIVE: Focus on user journeys, accessibility (WCAG 2.1 AA), and evidence-based recommendations.'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "tpm-orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/tpm-completion-checklist.md && echo '' && echo '🧹 JANITOR PROTOCOL: Clean up temp files, archive plan, commit and push.' && echo 'See .claude/skills/janitor/prompt.md for cleanup checklist.'"
          }
        ]
      }
    ]
  }
}
