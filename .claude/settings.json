  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/quality-check.md && echo '' && cat $CLAUDE_PROJECT_DIR/.claude/protocols/code-standards.md"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '--- Reminder: Run tests to verify this change works as expected ---'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/detect-production-review.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/detect-fix-request.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "portfolio-manager",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/risk-assessment-required.md"
          }
        ]
      },
      {
        "matcher": "tpm-orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ CRITICAL: Verify risk assessment exists in plan file before execution. Risk Manager invocation is MANDATORY.'"
          }
        ]
      },
      {
        "matcher": "shadow-code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/functional-verification.md"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "tpm-orchestrator",
        "hooks": [
          {
            "type": "command",
            "command": "cat $CLAUDE_PROJECT_DIR/.claude/protocols/tpm-completion-checklist.md"
          }
        ]
      }
    ]
  }
}
